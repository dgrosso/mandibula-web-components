{
  "name": "@mandibula/media-slot",
  "version": "0.1.0",
  "description": "Unified responsive image, video, and SVG media slot.",
  "type": "module",
  "module": "./src/index.js",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./unresolved.css": "./src/unresolved.css"
  },
  "files": [
    "src",
    "README.md",
    "custom-elements.json"
  ],
  "sideEffects": true,
  "customElements": "custom-elements.json",
  "scripts": {
    "manifest": "cem analyze --globs src/index.js --outdir .",
    "publint": "publint"
  },
  "keywords": [
    "web-components",
    "lit",
    "custom-elements",
    "mandibula",
    "media-slot"
  ],
  "author": "Mandíbula contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgrosso/mandibula-web-components.git",
    "directory": "packages/media-slot"
  },
  "bugs": {
    "url": "https://github.com/dgrosso/mandibula-web-components/issues"
  },
  "homepage": "https://github.com/dgrosso/mandibula-web-components/tree/development/packages/media-slot#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "lit": "^3.3.3",
    "@mandibula/scoped-inline-svg": "^0.1.0",
    "@mandibula/suspense": "^0.1.0",
    "@mandibula/video": "^0.1.0"
  }
}
