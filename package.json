{
  "name": "mandibula-web-components",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic web components built with Lit.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run changeset:validate && npm test && npm run release:test && npm run manifest && npm run publint && npm run release:validate && npm run demo:build",
    "storybook": "storybook dev -p 6006",
    "demo": "npm run storybook",
    "demo:build": "npm run demo:validate && storybook build --output-dir site",
    "demo:preview": "storybook dev -p 6006",
    "demo:validate": "node scripts/validate-stories.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "manifest": "npm run manifest --workspaces --if-present",
    "publint": "npm run publint --workspaces --if-present",
    "test": "npm run test:browser && npm run test:ssr",
    "test:browser": "web-test-runner --config web-test-runner.config.js",
    "test:ssr": "node scripts/ssr-smoke.mjs",
    "test:watch": "npm run test:browser -- --watch",
    "changeset": "changeset",
    "changeset:validate": "node scripts/validate-changesets.mjs",
    "version-packages": "changeset version",
    "release:plan": "node scripts/release-plan.mjs",
    "release:pack:github": "node scripts/release-pack.mjs github",
    "release:pack:npm": "node scripts/release-pack.mjs npm",
    "release:validate": "node scripts/release-validate.mjs",
    "release:test": "node --test tests/release/*.test.mjs",
    "release:publish:npm": "changeset publish"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.39.1",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/web-components-vite": "^10.5.6",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.22",
    "storybook": "^10.5.6",
    "vite": "^8.2.0"
  },
  "license": "MIT"
}
